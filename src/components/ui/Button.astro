---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  type?: "submit" | "button" | "reset";
}

const { href, variant = "primary", type = "submit" } = Astro.props;
const className = `button button--${variant}`;
---
{
  href ? (
    <a class={className} href={href}>
      <slot />
    </a>
  ) : (
    <button class={className} type={type}>
      <slot />
    </button>
  )
}
