---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

const mapSrc =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d8584.800199476651!2d-72.45536461390029!3d7.820091894641981!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e6646c0fd7e99a5%3A0x33baa479b349f493!2sIndustrias%20MM%2C%20c.a.!5e1!3m2!1ses!2sco!4v1779128915026!5m2!1ses!2sco";
const mapLink =
  "https://www.google.com/maps/search/?api=1&query=Industrias%20MM%20C.A.%20San%20Cristobal%20Venezuela";
---
<section class="section-padding home-section home-location-section">
  <Container>
    <SectionHeading eyebrow="Ubicacion" title="Donde encontrarnos" />
    <div class="map-wrapper" data-map-wrapper data-map-src={mapSrc}>
      <div class="map-placeholder">
        <div class="flow">
          <p class="eyebrow">San Cristobal, Venezuela</p>
          <h3>Industrias MM, C.A.</h3>
          <p>El mapa interactivo se prepara mientras exploras nuestros productos.</p>
          <a class="map-fallback-link" href={mapLink} target="_blank" rel="noreferrer">
            Abrir en Google Maps
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  const mapWrapper = document.querySelector("[data-map-wrapper]");
  const productSection = document.querySelector(".product-showcase-section");

  const loadMap = () => {
    if (!(mapWrapper instanceof HTMLElement) || mapWrapper.querySelector("iframe")) return;

    const iframe = document.createElement("iframe");
    iframe.src = mapWrapper.dataset.mapSrc ?? "";
    iframe.width = "100%";
    iframe.height = "450";
    iframe.loading = "lazy";
    iframe.referrerPolicy = "no-referrer-when-downgrade";
    iframe.allowFullscreen = true;
    iframe.title = "Mapa de Industrias MM";
    iframe.className = "map-frame";
    iframe.addEventListener("load", () => {
      mapWrapper.classList.add("map-wrapper--loaded");
    }, { once: true });

    mapWrapper.replaceChildren(iframe);
  };

  const scheduleMapLoad = () => {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(loadMap, { timeout: 1600 });
      return;
    }

    window.setTimeout(loadMap, 900);
  };

  if (productSection instanceof Element && "IntersectionObserver" in window) {
    try {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;

          observer.disconnect();
          scheduleMapLoad();
        },
        { rootMargin: "160px 0px" }
      );

      observer.observe(productSection);
    } catch {
      window.addEventListener("load", () => {
        window.setTimeout(scheduleMapLoad, 2600);
      }, { once: true });
    }
  } else {
    window.addEventListener("load", () => {
      window.setTimeout(scheduleMapLoad, 2600);
    }, { once: true });
  }
</script>
