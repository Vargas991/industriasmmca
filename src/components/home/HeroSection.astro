---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import { siteConfig } from "@/config/site";

const heroVideoMobile =
  "https://res.cloudinary.com/df9taulat/video/upload/q_auto:eco,vc_auto,w_720/v1778302402/WhatsApp_Video_2026-05-01_at_12.15.31_PM_uhant9.mp4";
const heroVideoDesktop =
  "https://res.cloudinary.com/df9taulat/video/upload/q_auto:eco,vc_auto,w_1280/v1778302402/WhatsApp_Video_2026-05-01_at_12.15.31_PM_uhant9.mp4";
---
<section class="hero-section">
  <div class="hero-media" aria-hidden="true">
    <video autoplay muted loop playsinline preload="metadata" data-hero-video>
      <source src={heroVideoMobile} type="video/mp4" media="(max-width: 720px)" />
      <source src={heroVideoDesktop} type="video/mp4" />
    </video>
  </div>
  <Container>
    <div class="hero-grid">
      <div class="hero-copy flow">
        <p class="eyebrow">Soluciones industriales</p>
        <h1>{siteConfig.tagline}</h1>
        <p>{siteConfig.description}</p>
        <div class="hero-actions">
          <Button href="/contacto/">Solicitar cotización</Button>
          <Button href="/productos/" variant="secondary">Ver catálogo</Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  const heroVideoEl = document.querySelector("[data-hero-video]");

  if (heroVideoEl?.readyState >= 3) {
    heroVideoEl.classList.add("is-ready");
  }

  heroVideoEl?.addEventListener(
    "canplay",
    () => {
      heroVideoEl.classList.add("is-ready");
    },
    { once: true }
  );
</script>
