  {
    name: "Cliente Industrias MM",
    logo: "/images/clientes/transparent/q1ac1rvlxn5dcxfbp1wi.webp",
  },
  {
    name: "Super Garzon",
    logo: "/images/clientes/transparent/supergarzon-logo-1589950454.webp",
  },
];

const marqueeClients = [...clients, ...clients];
---
<section class="home-section clients-marquee-section" aria-label="Clientes que han confiado en Industrias MM">
  <Container>
    <div class="clients-marquee-heading">
      <p class="eyebrow">Nuestros clientes</p>
      <h2>Empresas que confian en nosotros</h2>
    </div>
    <div class="clients-marquee">
      <div class="clients-marquee__track">
        {marqueeClients.map((client) => (
          <div class="clients-marquee__item">
            <img src={client.logo} alt={client.name} width="180" height="80" loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
