  },
  {
    name: "Farmabien",
    logo: "/images/clientes/transparent/farmabien_logo.webp",
  },
  {
    name: "Cliente Industrias MM",
    logo: "/images/clientes/transparent/ghokvC6ihFfadEbg1DQIucSfWdod4OVPA9nGc26Y.webp",
  },
  {
    name: "Jautec",
    logo: "/images/clientes/transparent/i0gqm3dbrtgyutgi49uu.webp",
  },
  {
    name: "Cliente Industrias MM",
    logo: "/images/clientes/transparent/images.webp",
  },
  {
    name: "Cliente Industrias MM",
    logo: "/images/clientes/transparent/logo.webp",
  },
  {
    name: "Grupo JHS",
    logo: "/images/clientes/transparent/Logo_Grupo_JHS.webp",
  },
  {
    name: "Macuro",
    logo: "/images/clientes/transparent/n1eb1cgvyzg6uyiubrrq.webp",
  },
  {
    name: "Mango Center",
    logo: "/images/clientes/transparent/o1scclyoacwjqujkdixs.webp",
